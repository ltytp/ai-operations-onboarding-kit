{
  "profile_name": "safe-metadata-default",
  "profile_version": "1.0.0",
  "scan_mode": "metadata-only",
  "max_hash_bytes": 10485760,
  "max_config_read_bytes": 65536,
  "exclude_directories": [
    ".git",
    ".svn",
    ".hg",
    "node_modules",
    ".venv",
    "venv",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".terraform",
    "dist",
    "build",
    "coverage",
    ".next",
    ".nuxt",
    "target",
    "bin",
    "obj"
  ],
  "exclude_paths": [],
  "generated_directory_names": [
    "generated",
    "outputs",
    "output",
    "artifacts",
    "cache",
    "tmp",
    "temp",
    "dist",
    "build",
    "coverage",
    "target",
    "bin",
    "obj"
  ],
  "content_inspection_allowlist": [
    "AGENTS.md",
    "SKILL.md",
    "CODEOWNERS",
    "package.json",
    "pyproject.toml",
    "Cargo.toml",
    "go.mod",
    "pom.xml",
    "build.gradle",
    "settings.gradle",
    "Makefile",
    "Dockerfile"
  ],
  "sensitive_name_patterns": [
    ".env",
    ".env.*",
    "*.pem",
    "*.pfx",
    "*.p12",
    "id_rsa",
    "id_ed25519",
    "*secret*",
    "*credential*"
  ]
}
